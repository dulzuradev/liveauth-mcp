# IMPORTANT: Mount layout for docker-compose volumes
# Mount: ./LiveAuthWeb/dist → /srv (flat, no subdirs)
# Expected structure:
#   /srv/index.html           → liveauth.app
#   /srv/docs/*              → docs.liveauth.app
#   /srv/liveauth-admin/*    → admin.liveauth.app
# DO NOT use /srv/browser/* — that's the old structure

{
  email admin@liveauth.app
}

liveauth.app {
    root * /srv
    try_files {path} /index.html
    file_server
}

api.liveauth.app {
    @options method OPTIONS
    handle @options {
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, PATCH, DELETE"
            Access-Control-Allow-Headers "content-type, authorization, x-lw-public, x-lw-secret, x-lw-api-key, x-lw-sdk-version"
            Access-Control-Max-Age "86400"
        }
        respond "" 204
    }
    reverse_proxy liveauth-api:8080 {
        header_down Access-Control-Allow-Origin "{header.origin}"
    }
}

admin.liveauth.app {
    root * /srv/liveauth-admin
    try_files {path} /index.html
    file_server
}

docs.liveauth.app {
    root * /srv/docs
    try_files {path} /index.html
    file_server
}
