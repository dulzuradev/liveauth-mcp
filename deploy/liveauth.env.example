# Copy this file to /opt/liveauth/liveauth.env on the server.
# Replace every CHANGE_ME value, make it readable only by the LiveAuth service
# account, and run: chmod 600 /opt/liveauth/liveauth.env

ConnectionStrings__Default='Data Source=/opt/liveauth/.liveauth.db'
Jwt__SigningKey='CHANGE_ME_RANDOM_64_OR_MORE_BYTES'
Jwt__Issuer='LiveAuth'
Jwt__Audience='LiveAuthUsers'
LiveAuth__PowHmacSecret='CHANGE_ME_RANDOM_32_OR_MORE_BYTES'
LiveAuth__DemoProjectId='00000000-0000-0000-0000-000000000002'

# Base64 of an RSA private key PEM. See docs/COSTSHIELD-PRODUCTION.md.
CostShield__SigningPrivateKeyPemBase64='CHANGE_ME_BASE64_PKCS8_PRIVATE_KEY'
CostShield__SigningKeyId='costshield-rs256-v1'

GitHub__ClientId='CHANGE_ME'
GitHub__ClientSecret='CHANGE_ME'
Resend__ApiKey='CHANGE_ME'
Resend__FromEmail='noreply@liveauth.app'
Resend__FromName='LiveAuth'
Lnd__BaseUrl='https://localhost:8080'
Lnd__Macaroon='CHANGE_ME'
Lnd__UseMock='false'
ReverseProxy__TrustForwardedHeaders='true'

# LiveAuth Bitcoin Agent Gateway. Keep these credentials readable only by the service account.
BitcoinGateway__Enabled='false'
BitcoinGateway__RpcUrl='http://127.0.0.1:8332'
BitcoinGateway__RpcUser='CHANGE_ME'
BitcoinGateway__RpcPassword='CHANGE_ME'
BitcoinGateway__Network='mainnet'
BitcoinGateway__MaxRawTransactionBytes='400000'
BitcoinGateway__MaxFeeRateSatPerVbyte='1000'
BitcoinGateway__MaxAbsoluteFeeSats='10000000'
BitcoinGateway__RpcTimeoutMs='10000'
BitcoinGateway__ReadRateLimitPerMinute='60'
BitcoinGateway__BroadcastRateLimitPerMinute='5'
BitcoinGateway__OperationRetentionDays='90'
BitcoinGateway__CleanupIntervalHours='24'
