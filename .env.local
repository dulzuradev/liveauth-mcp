# LiveAuth Local Development Environment
# Copy this to .env and adjust as needed

# API Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database
DB_PROVIDER=sqlite
ConnectionStrings__Default=Data Source=/data/liveauth.db

# Skip payment for local admin testing
Admin__SkipPayment=true

# JWT (dev key - not for production)
