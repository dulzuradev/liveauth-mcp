<!-- ================= TOP NAV ================= -->
<mat-toolbar class="la-toolbar" color="primary">
  <div class="la-toolbar-left">
    <mat-icon class="bolt">bolt</mat-icon>
    <span class="brand">
      LiveAuth
      <span class="beta-badge">BETA</span>
    </span>
    <span class="subbrand">Lightning Wall</span>

  </div>

  <span class="spacer"></span>

  <nav class="la-nav">
    <a href="#how">How it works</a>
    <a href="#features">Features</a>
    <a href="#usecases">Use cases</a>
    <a href="#fees">Fees</a>
    <a href="#faq">FAQ</a>
  </nav>

  <span class="spacer"></span>

  <div class="la-toolbar-cta">
    <button mat-stroked-button class="ghost" routerLink="/demo">
      Try Demo
    </button>
    <button mat-raised-button class="primary" routerLink="/dev/projects">
      Developer Portal
    </button>
  </div>
</mat-toolbar>

<!-- ================= HERO ================= -->
<section class="hero">
  <div class="hero-bg"></div>

  <div class="hero-inner">
    <!-- COPY -->
    <div class="hero-copy">
      <mat-chip-set class="hero-chipset">
        <mat-chip selected color="accent">
          <mat-icon>verified_user</mat-icon>
          Human Verification
        </mat-chip>
        <mat-chip>
          <mat-icon>bolt</mat-icon>
          Lightning Native
        </mat-chip>
        <mat-chip>
          <mat-icon>code</mat-icon>
          Dev-Friendly API
        </mat-chip>
      </mat-chip-set>

      <h1>
        Stop bots instantly with cryptographic Proof-of-Work.
        <span class="glow">Lightning fallback. No CAPTCHAs. No puzzles.</span>
      </h1>

      <p class="hero-sub">
        Browsers solve a short cryptographic proof in milliseconds.
        If they can’t, a Lightning payment cleanly proves human intent.
      </p>

      <div class="hero-actions">
        <button mat-raised-button class="primary big" routerLink="/dev/projects">
          <mat-icon>build</mat-icon>
          Get API Keys
        </button>
        <button mat-stroked-button class="ghost big" routerLink="/demo">
          <mat-icon>bolt</mat-icon>
          Try Demo
        </button>
        <a
          mat-stroked-button
          href="https://github.com/dulzuradev/liveauth-js/blob/main/README.md"
          target="_blank"
          rel="noopener">
          📄 Documentation
        </a>
      </div>

      <div class="hero-metrics">
        <div class="metric">
          <div class="metric-num">1–10 sats</div>
          <div class="metric-label">Typical verification cost</div>
        </div>
        <div class="metric">
          <div class="metric-num">&lt;1 sec</div>
          <div class="metric-label">Time to verify</div>
        </div>
        <div class="metric">
          <div class="metric-num">Exponential</div>
          <div class="metric-label">Bot deterrence</div>
        </div>
      </div>

      <div class="social-proof">
        <div class="social-title">Built for developers shipping real apps</div>
        <div class="social-logos">
          <div class="logo-pill">API Gateways</div>
          <div class="logo-pill">Livestream Platforms</div>
          <div class="logo-pill">Signup Funnels</div>
          <div class="logo-pill">Public APIs</div>
        </div>
        <div class="social-sub">
          Early access users are onboarding now.
        </div>
      </div>
    </div>

    <!-- VISUAL -->
    <div class="hero-visual">
      <div class="hero-card">
        <img
          [src]="heroImageUrl"
          class="hero-logo"
          alt="LiveAuth Logo"/>

        <div class="hero-card-caption">
          <div class="caption-title">Lightning Wall</div>
          <div class="caption-sub">
            A cryptographic access wall that scales with demand — not CAPTCHAs.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= WHY LIGHTNING ================= -->
<section id="why-ln" class="section mini alt">
  <h2>Why Lightning?</h2>
  <p class="section-sub">
    Lightning makes verification instantaneous, cheap, and globally accessible.
  </p>

  <div class="mini-grid">
    <div class="mini-card">
      <mat-icon>flash_on</mat-icon>
      <h3>Instant proof</h3>
      <p>Settlement confirms human intent in under a second.</p>
    </div>
    <div class="mini-card">
      <mat-icon>savings</mat-icon>
      <h3>Near-zero cost</h3>
      <p>1–10 sats is fractions of a cent, even at scale.</p>
    </div>
    <div class="mini-card">
      <mat-icon>verified</mat-icon>
      <h3>Cryptographic trust</h3>
      <p>Proof-of-payment can’t be faked by bots.</p>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section id="how" class="section">
  <h2>How it works</h2>
  <p class="section-sub">
    Three steps. Browser-native Proof-of-Work with a Lightning fallback.
    No centralized identity. No tracking.
  </p>

  <div class="steps">
    <div class="step">
      <mat-icon>receipt_long</mat-icon>
      <h3>1. Request challenge</h3>
      <p>User receives a short cryptographic challenge.</p>
      <div class="step-meta">&lt;200 ms</div>
    </div>

    <div class="step">
      <mat-icon>qr_code_2</mat-icon>
      <h3>2. Solve or fallback</h3>
      <p>
        Browsers solve Proof-of-Work automatically.
        If not, Lightning payment proves intent instead.
      </p>
      <div class="step-meta">&lt;1 sec</div>
    </div>

    <div class="step">
      <mat-icon>verified</mat-icon>
      <h3>3. Get your JWT</h3>
      <p>
        LiveAuth detects settlement and returns a time-boxed access token.
      </p>
      <div class="step-meta">Immediate</div>
    </div>
  </div>

  <!-- QUICK START -->
  <mat-card class="snippet-card liveauth-quickstart">
    <div class="snippet-header">
      <mat-icon>code</mat-icon>
      <div>
        <div class="snippet-title">Integrate in minutes</div>
        <div class="snippet-sub">
          Drop LiveAuth into any frontend — no CAPTCHA, no tracking.
        </div>
      </div>
    </div>

    <pre class="snippet">
      <code
        class="language-ts"
        [textContent]="liveAuthSnippet">
      </code>
    </pre>

    <div class="snippet-footer">
      <span class="snippet-note">
        Returns a short-lived JWT if the user is human
        (Proof-of-Work → Lightning fallback).
      </span>

      <div class="snippet-actions">
        <a
          mat-button
          class="link"
          href="https://github.com/dulzuradev/liveauth-js/blob/main/README.md"
          target="_blank"
          rel="noopener">
          View full docs →
        </a>

        <button mat-stroked-button class="ghost" routerLink="/demo">
          Try the demo
        </button>
      </div>
    </div>
  </mat-card>
</section>

<!-- ================= FEATURES ================= -->
<section id="features" class="section alt">
  <h2>Designed for production</h2>
  <p class="section-sub">
    Built to guard real apps — not just demos.
  </p>

  <div class="feature-grid">
    <mat-card class="feature">
      <mat-icon>shield</mat-icon>
      <h3>Anti-spam & anti-DDoS</h3>
      <p>Payments introduce real-world cost per request, crushing abuse.</p>
    </mat-card>

    <mat-card class="feature">
      <mat-icon>memory</mat-icon>
      <h3>Stateless Proof-of-Work</h3>
      <p>No cookies. No fingerprinting. Adaptive difficulty.</p>
    </mat-card>

    <mat-card class="feature">
      <mat-icon>key</mat-icon>
      <h3>API keys & rotation</h3>
      <p>Public/secret keys with easy reset and revocation.</p>
    </mat-card>

    <mat-card class="feature">
      <mat-icon>devices</mat-icon>
      <h3>Mobile-first UX</h3>
      <p>QR, invoice copy, and LN wallet deep-links built in.</p>
    </mat-card>

    <mat-card class="feature">
      <mat-icon>privacy_tip</mat-icon>
      <h3>Privacy-preserving</h3>
      <p>No PII stored. Only proof-of-payment + expiry.</p>
    </mat-card>

    <mat-card class="feature">
      <mat-icon>tune</mat-icon>
      <h3>Policy controls</h3>
      <p>Set sats, expiry windows, and endpoints per project.</p>
    </mat-card>
  </div>
</section>

<!-- ================= FEES ================= -->
<section id="fees" class="section alt">
  <h2>Fees</h2>
  <p class="section-sub">
    Start free. Pay as your traffic grows.
    <span class="muted">No credit card required.</span>
  </p>

  <div class="pricing-grid">
    <mat-card class="price">
      <h3>Free</h3>
      <div class="price-num">$0</div>
      <div class="price-sub">forever</div>
      <ul>
        <li>1 project</li>
        <li>Up to 1k verifications / month</li>
        <li>Community support</li>
      </ul>
      <button mat-stroked-button class="ghost full" routerLink="/dev/projects">
        Get started
      </button>
    </mat-card>

    <mat-card class="price featured">
      <div class="badge">Most popular</div>
      <h3>Pro</h3>
      <div class="price-num">0.5%</div>
      <div class="price-sub">on verification sats</div>
      <ul>
        <li>Unlimited projects</li>
        <li>Custom sats per action</li>
        <li>Priority support</li>
        <li>Higher limits</li>
      </ul>
      <div class="price-note">
        Fees are paid by end-users, not developers.
      </div>
      <button mat-raised-button class="primary full" routerLink="/dev/projects">
        Go Pro
      </button>
    </mat-card>

    <mat-card class="price">
      <h3>Enterprise</h3>
      <div class="price-num">Custom</div>
      <div class="price-sub">SLA + dedicated infra</div>
      <ul>
        <li>Dedicated node / LND</li>
        <li>SLA + onboarding</li>
        <li>Advanced policies</li>
      </ul>
      <button mat-stroked-button class="ghost full">
        Contact
      </button>
    </mat-card>
  </div>
</section>

<!-- ================= FAQ ================= -->
<section id="faq" class="section">
  <h2>FAQ</h2>
  <div class="faq-grid">
    <mat-card class="faq">
      <h3>Do users need an account?</h3>
      <p>No. They just pay a Lightning invoice to prove intent.</p>
    </mat-card>

    <mat-card class="faq">
      <h3>Is this a CAPTCHA replacement?</h3>
      <p>Yes — with economic friction instead of puzzles.</p>
    </mat-card>

    <mat-card class="faq">
      <h3>What about privacy?</h3>
      <p>No tracking. No fingerprinting. No PII.</p>
    </mat-card>

    <mat-card class="faq">
      <h3>Can I set sats per endpoint?</h3>
      <p>Yes — per project, per action.</p>
    </mat-card>
  </div>
</section>

<!-- ================= CTA ================= -->
<section class="cta">
  <h2>Ready to gate your app with sats?</h2>
  <p>Drop in Lightning Wall and start earning while you block bots.</p>
  <div class="cta-actions">
    <button mat-raised-button class="primary big" routerLink="/dev/projects">
      <mat-icon>build</mat-icon>
      Get API Keys
    </button>
    <button mat-stroked-button class="ghost big" routerLink="/demo">
      <mat-icon>bolt</mat-icon>
      Try Demo
    </button>
  </div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="footer">
  <div class="footer-left">
    <mat-icon>bolt</mat-icon>
    <span>LiveAuth Lightning Wall</span>
  </div>

  <div class="footer-right">
    <a routerLink="/demo">Demo</a>
    <a routerLink="/dev/projects">Developers</a>
    <a href="https://github.com/dulzuradev/liveauth-js/blob/main/README.md">Docs</a>
    <a href="#faq">FAQ</a>
  </div>
</footer>
