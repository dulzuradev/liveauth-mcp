{
  "info": {
    "name": "LiveAuth Lite - Developer API",
    "_postman_id": "c4b9b0d3-9c9a-4e6c-8b3d-1a2f3e4d5c6b",
    "description": "Lightning verification + API key auth + token validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5001" },
    { "key": "adminJwt", "value": "" },
    { "key": "devSecretKey", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "liveAuthToken", "value": "" }
  ],
  "item": [
    {
      "name": "Admin Login (JWT)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/admin-auth/login", "host": ["{{baseUrl}}"], "path": ["api","admin-auth","login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set('adminJwt', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Developer Project (returns keys once)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/dev/projects", "host": ["{{baseUrl}}"], "path": ["api","dev","projects"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"developerEmail\": \"dev@example.com\",\n  \"name\": \"My First App\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('devSecretKey', json.secretKey);",
              "pm.collectionVariables.set('projectId', json.projectId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth Start (LN invoice + session)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{devSecretKey}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/auth/start", "host": ["{{baseUrl}}"], "path": ["api","auth","start"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userRef\": \"user_123\",\n  \"amountSats\": 200,\n  \"memo\": \"LiveAuth human verification\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('sessionId', json.sessionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth Confirm (poll until paid)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{devSecretKey}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/auth/confirm", "host": ["{{baseUrl}}"], "path": ["api","auth","confirm"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.verified && json.token) pm.collectionVariables.set('liveAuthToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify LiveAuth Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/api/auth/verify-token", "host": ["{{baseUrl}}"], "path": ["api","auth","verify-token"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{liveAuthToken}}\"\n}"
        }
      }
    }
  ]
}
