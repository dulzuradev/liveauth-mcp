{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dulzuradev/liveauth-mcp",
  "title": "LiveAuth MCP Server",
  "description": "Runtime PoW, Lightning, L402, metering, and paid tool access for MCP clients.",
  "websiteUrl": "https://liveauth.app/integrations/goose",
  "repository": {
    "url": "https://github.com/dulzuradev/liveauth-mcp",
    "source": "github"
  },
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@liveauth-labs/mcp-server",
      "version": "1.2.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your LiveAuth project public key (la_pk_…).",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "placeholder": "la_pk_…",
          "name": "LIVEAUTH_API_KEY"
        },
        {
          "description": "Override for self-hosted LiveAuth. Defaults to https://api.liveauth.app.",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "https://api.liveauth.app",
          "name": "LIVEAUTH_API_BASE"
        },
        {
          "description": "Use the legacy locally simulated Lightning demo. Defaults to false.",
          "isRequired": false,
          "format": "boolean",
          "isSecret": false,
          "default": "false",
          "name": "LIVEAUTH_DEMO"
        }
      ]
    }
  ]
}
