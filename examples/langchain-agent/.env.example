# LiveAuth MCP LangChain Agent - Environment Variables
# Copy this file to .env and fill in your values

# Required: Your LiveAuth API key
# Get from: https://liveauth.app/dashboard → Project → API Keys
LIVEAUTH_API_KEY=la_pk_your_key_here

# Optional: API URL (default: https://api.liveauth.app)
# For local development:
# LIVEAUTH_API_URL=http://localhost:5000

# Optional: Use Lightning instead of PoW for authentication
# false = PoW (CPU intensive, free)
# true = Lightning (requires payment)
USE_LIGHTNING=false

# Optional: Run in demo mode (no real authentication)
# Set to 'true' to skip auth and use mock tokens
LIVEAUTH_DEMO=false

# Required: OpenAI API key for LangChain LLM
OPENAI_API_KEY=sk-your_openai_key

# Optional: Anthropic API key (alternative to OpenAI)
# ANTHROPIC_API_KEY=sk-ant-your_key_here
