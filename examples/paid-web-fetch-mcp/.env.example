# LiveAuth Paid Web Fetch MCP

# LiveAuth API base URL.
LIVEAUTH_API_URL=http://127.0.0.1:5089

# Project public key used for MCP auth/session APIs.
LIVEAUTH_PUBLIC_KEY=la_pk_demo

# Seeded first-party Web Fetch tool ID from the backend Phase 1 seed.
LIVEAUTH_TOOL_ID=00000000-0000-0000-0000-000000000005

# Optional: pre-authenticated MCP JWT. If omitted, pass liveauthJwt in tool input.
LIVEAUTH_JWT=

# Tool pricing.
WEB_FETCH_DEFAULT_COST_SATS=5
WEB_FETCH_METADATA_COST_SATS=1

# Fetch safety/limit defaults.
WEB_FETCH_DEFAULT_MAX_BYTES=200000
WEB_FETCH_MAX_BYTES=500000
WEB_FETCH_TIMEOUT_MS=10000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_USER_AGENT=LiveAuth-WebFetch-MCP/1.0
