# LiveAuth Sample MCP Server Configuration
# Copy this to .env and fill in your values

# LiveAuth API Key (get from https://liveauth.app/dashboard)
LIVEAUTH_API_KEY=la_pk_your_key_here

# LiveAuth API URL (default: https://api.liveauth.app)
LIVEAUTH_API_URL=https://api.liveauth.app

# MCP Server URL (for client connection)
MCP_SERVER_URL=http://localhost:3000

# Server port (for HTTP mode, not stdio)
PORT=3000
