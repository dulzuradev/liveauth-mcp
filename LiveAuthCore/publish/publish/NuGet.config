<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ensure builds on non-Windows hosts don't reference Windows-specific fallback package folders -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <!-- Optional: rely on default global packages folder; uncomment to force a specific path -->
  <!--
  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%/.nuget/packages" />
  </config>
  -->
</configuration>
