{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lnd": {
    "BaseUrl": "https://host.docker.internal:8080",
    "Macaroon": "",
    "UseMock": false
  },
  "Stripe": {
    "ApiKey": ""
  },
  "OpenNode": {
    "ApiKey": "",
    "BaseUrl": "https://api.opennode.com/v1"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "LiveAuth",
    "Audience": "LiveAuthUsers"
  },
  "TokenExpiry": {
    "AdminHours": 720,
    "DeveloperHours": 2,
    "DefaultMinutes": 30
  },
  "Demo": {
    "AllowSimulateAuth": false
  },
  "LiveAuthAdmin": {
    "AllowedEmails": [
      "dulzuradev@gmail.com"
    ]
  },
  "LiveAuth": {
    "DemoProjectId": "00000000-0000-0000-0000-000000000002"
  },
  "CostShield": {
    "TokenIssuer": "https://api.liveauth.app",
    "TokenAudience": "liveauth-costshield",
    "SigningKeyId": "costshield-rs256-v1",
    "ChallengeLifetimeSeconds": 120,
    "CompleteRateLimitPerMinute": 30
  },
  "Meter": {
    "ChallengeIdempotencyWindowSeconds": 30,
    "InvoiceExpiryMinutes": 10,
    "ReceiptKeyId": "liveauth-meter-v1",
    "AllowInsecureLightningInTest": false,
    "AllowPrivateLightningProviders": false
  },
  "PermitSignal": {
    "SeedDemoData": false,
    "Tools": {
      "SearchProjects": { "PriceSats": 5 },
      "FindOpportunities": { "PriceSats": 10 },
      "AnalyzeProject": { "PriceSats": 15 },
      "PropertyHistory": { "PriceSats": 20 }
    },
    "Sync": {
      "Enabled": false,
      "InitialLookbackDays": 30,
      "IntervalMinutes": 60,
      "PageSize": 500,
      "MaximumPagesPerSource": 10
    },
    "Scoring": {
      "IssuedWithin3Days": 20,
      "IssuedWithin7Days": 15,
      "IssuedWithin30Days": 5,
      "Commercial": 15,
      "ValueOverOneMillion": 25,
      "ValueOverTwoHundredFiftyThousand": 15,
      "ValueOverOneHundredThousand": 8,
      "StrongTradeMatch": 25,
      "WeakTradeMatch": 10,
      "NewConstruction": 15,
      "Renovation": 5
    }
  },
  "LightningAuthFees": {
    "InvoiceFeeBps": 200,
    "InvoiceMinimumFeeSats": 1,
    "BundleMarkupBps": 1500,
    "BundleMarkupMinimumFeeSats": 1
  },
  "ConnectionStrings": {
    "Default": "Data Source=/data/liveauth.db"
  }
}
