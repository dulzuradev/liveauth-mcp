{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Lnd": {
    "UseMock": false
  },
  "Webhooks": {
    "DefaultSecret": "proof_of_work_secret"
  },
  "DevLogin": {
    "AmountSats": 21,
    "ExpiryMinutes": 10
  },
  "Demo": {
    "AllowSimulateAuth": true
  },
  "LiveAuth": {
    "PowHmacSecret": "dev-only-change-me-32+chars"
  },
  "Jwt": {
    "SigningKey": "dev-super-secret-32-char-minimum-key",
    "Issuer": "LiveAuth",
    "Audience": "LiveAuthUsers"
  }
}
