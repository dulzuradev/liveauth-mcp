# SSH Configuration
# SSH_PRIVATE_KEY_PATH=/path/to/private/key

# CostShield production token signing
# Generate once: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
# Store the PEM as a single quoted value with literal \n line separators.
# COSTSHIELD_SIGNING_PRIVATE_KEY_PEM="<PEM-encoded RSA private key>"
# COSTSHIELD_SIGNING_KEY_ID=costshield-rs256-v1

# LiveAuth Meter (32-byte base64 values recommended; never commit production values)
Meter__EncryptionKey=
Meter__CredentialSigningKey=
Meter__ReceiptSigningKey=
Meter__ChallengeHmacKey=
Meter__ReceiptKeyId=liveauth-meter-v1
Meter__ChallengeIdempotencyWindowSeconds=30
Meter__InvoiceExpiryMinutes=10
Meter__AllowInsecureLightningInTest=false
Meter__AllowPrivateLightningProviders=false

# PermitSignal (public construction-permit intelligence)
PermitSignal__ProjectId=
PermitSignal__SeedDemoData=false
PermitSignal__Sync__Enabled=false
PermitSignal__Sync__InitialLookbackDays=30
PermitSignal__Sync__IntervalMinutes=60
PermitSignal__Sync__PageSize=500
PermitSignal__Sync__MaximumPagesPerSource=10
PermitSignal__Tools__SearchProjects__PriceSats=5
PermitSignal__Tools__FindOpportunities__PriceSats=10
PermitSignal__Tools__AnalyzeProject__PriceSats=15
PermitSignal__Tools__PropertyHistory__PriceSats=20

# Bitcoin Agent Gateway (never commit RPC credentials)
BitcoinGateway__Enabled=false
BitcoinGateway__RpcUrl=http://127.0.0.1:8332
BitcoinGateway__RpcUser=
BitcoinGateway__RpcPassword=
# Prefer the node cookie when LiveAuth runs under an account allowed to read it:
BitcoinGateway__RpcCookieFile=
BitcoinGateway__Network=mainnet
BitcoinGateway__MaxRawTransactionBytes=400000
BitcoinGateway__MaxFeeRateSatPerVbyte=1000
BitcoinGateway__MaxAbsoluteFeeSats=10000000
BitcoinGateway__RpcTimeoutMs=10000
BitcoinGateway__ReadRateLimitPerMinute=60
BitcoinGateway__BroadcastRateLimitPerMinute=5
BitcoinGateway__OperationRetentionDays=90
BitcoinGateway__CleanupIntervalHours=24
BitcoinGateway__Tools__FeeEstimates__PriceSats=3
BitcoinGateway__Tools__MempoolSummary__PriceSats=3
BitcoinGateway__Tools__PreflightTransaction__PriceSats=5
BitcoinGateway__Tools__BroadcastTransaction__PriceSats=25
BitcoinGateway__Tools__TransactionStatus__PriceSats=3
