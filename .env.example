# SSH Configuration
# SSH_PRIVATE_KEY_PATH=/path/to/private/key

# CostShield production token signing
# Generate once: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
# Store the PEM as a single quoted value with literal \n line separators.
# COSTSHIELD_SIGNING_PRIVATE_KEY_PEM="<PEM-encoded RSA private key>"
# COSTSHIELD_SIGNING_KEY_ID=costshield-rs256-v1
